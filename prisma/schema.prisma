// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  telegram_id  String   @unique
  first_name   String?
  timezone     String?
  calorie_goal Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  food_logs FoodLog[]

  @@map("users")
}

model ConversationState {
  telegram_id String   @id
  state       String   @default("idle")
  context     Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("conversation_state")
}

model GeminiKey {
  id         Int      @id @default(autoincrement())
  label      String
  project_id String?
  api_key    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("gemini_keys")
}

model FoodLog {
  id              Int       @id @default(autoincrement())
  user_id         Int
  session_id      String?
  log_date        DateTime  @db.Date
  meal_type       String?
  ai_raw_response String?
  confirmed       Boolean   @default(false)
  is_deleted      Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  food_items FoodItem[]

  @@index([user_id, log_date])
  @@map("food_logs")
}

model FoodItem {
  id           Int      @id @default(autoincrement())
  food_log_id  Int
  name         String
  quantity     Float    @default(1)
  unit         String   @default("g")
  calories     Float?
  protein_g    Float?
  carbs_g      Float?
  fat_g        Float?
  fiber_g                Float?
  sugar_g                Float?
  net_carbs_g            Float?
  saturated_fat_g        Float?
  trans_fat_g            Float?
  monounsaturated_fat_g  Float?
  polyunsaturated_fat_g  Float?
  cholesterol_mg         Float?
  sodium_mg              Float?
  potassium_mg           Float?
  calcium_mg             Float?
  iron_mg                Float?
  magnesium_mg           Float?
  phosphorus_mg          Float?
  zinc_mg                Float?
  selenium_mcg           Float?
  vitamin_a_mcg          Float?
  vitamin_c_mg           Float?
  vitamin_d_mcg          Float?
  vitamin_e_mg           Float?
  vitamin_k_mcg          Float?
  vitamin_b1_mg          Float?
  vitamin_b2_mg          Float?
  vitamin_b3_mg          Float?
  vitamin_b5_mg          Float?
  vitamin_b6_mg          Float?
  vitamin_b9_mcg         Float?
  vitamin_b12_mcg        Float?
  glycemic_index         Float?
  glycemic_load          Float?
  omega3_g               Float?
  omega6_g               Float?
  water_content_g        Float?
  confidence_score       Float?
  notes                  String?
  raw_json     Json?
  data_source  String   @default("ai_text")
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  food_log FoodLog @relation(fields: [food_log_id], references: [id], onDelete: Cascade)

  @@index([food_log_id])
  @@map("food_items")
}
